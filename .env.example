# Supabase (server-side only — used by the Netlify Function)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Frontend (Vite) — the API base URL the browser calls.
# On Netlify this is the same site: /.netlify/functions/api
VITE_API_URL=/.netlify/functions/api
